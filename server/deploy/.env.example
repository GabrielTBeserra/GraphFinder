# Required. Use a strong generated password outside local development.
POSTGRES_PASSWORD=change-me

# Optional deployment tuning.
SITE_ADDRESS=:80
GF_HTTP_PORT=8080
GF_HTTPS_PORT=8443
RUST_LOG=info

# Internal Git hosts are denied by default. Enable only for trusted networks.
GF_ALLOW_PRIVATE_GIT_HOSTS=false
GF_ALLOWED_GIT_HOSTS=
