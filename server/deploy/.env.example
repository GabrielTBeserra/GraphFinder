# Required. Use a strong generated password outside local development.
POSTGRES_PASSWORD=change-me

# Optional deployment tuning.
SITE_ADDRESS=:80
GF_HTTP_PORT=8080
GF_HTTPS_PORT=8443
RUST_LOG=info
GF_LOG_FORMAT=json
GF_DEFAULT_TENANT_SLUG=default


# Required before storing private Git provider tokens. Generate 32 bytes as hex/base64,
# for example: openssl rand -hex 32. Keep backups safe; losing it makes stored tokens unreadable.
GF_CREDENTIALS_ENCRYPTION_KEY=

# Internal Git hosts are denied by default. Enable only for trusted networks.
GF_ALLOW_PRIVATE_GIT_HOSTS=false
GF_ALLOWED_GIT_HOSTS=

# Optional OIDC/SSO for human admin users. PATs remain the recommended auth for MCP agents.
# GF_OIDC_REDIRECT_URI must be the public API callback URL, usually https://<host>/api/v1/auth/oidc/callback.
GF_OIDC_ISSUER=
GF_OIDC_CLIENT_ID=
GF_OIDC_CLIENT_SECRET=
GF_OIDC_REDIRECT_URI=
GF_OIDC_TENANT_SLUG=default
GF_OIDC_SCOPES=openid profile email
GF_OIDC_ROLE_CLAIM=groups
# Example: graphfinder-admins=admin,graphfinder-members=member
GF_OIDC_ROLE_MAP=
GF_OIDC_DEFAULT_ROLE=viewer
GF_OIDC_REQUIRE_VERIFIED_EMAIL=true
GF_OIDC_SUCCESS_REDIRECT=/
GF_OIDC_BUTTON_LABEL=Continue with SSO
