{
  "description": "Creates an isolated project (markdown vault + vector index) at a path.",
  "name": "create_project",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "name": {
        "description": "Project name (e.g. 'Backend')",
        "type": "string"
      },
      "path": {
        "description": "Absolute folder path (optional)",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "name"
    ],
    "type": "object"
  }
}