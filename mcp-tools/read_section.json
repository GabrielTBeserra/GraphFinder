{
  "description": "Reads one ##/### section of a note. Use after get_compressed_context maps the headings.",
  "name": "read_section",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "project": {
        "default": null,
        "description": "Project ID (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "section": {
        "description": "H2/H3 heading or deep-link fragment",
        "type": "string"
      },
      "target": {
        "description": "Note title or ID",
        "type": "string"
      }
    },
    "required": [
      "target",
      "section"
    ],
    "type": "object"
  }
}