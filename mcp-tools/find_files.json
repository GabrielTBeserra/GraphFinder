{
  "description": "Finds files by glob/name/language with import-degree stats. Use for paths; search_code for content.",
  "name": "find_files",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "fields": {
        "default": null,
        "description": "'ids': paths only",
        "type": [
          "string",
          "null"
        ]
      },
      "language": {
        "default": null,
        "description": "Language filter (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "default": null,
        "description": "Max files (default: 20)",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "offset": {
        "default": null,
        "description": "Pagination offset (default: 0)",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "pattern": {
        "default": null,
        "description": "Glob/name match (e.g. '*.tsx', optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "project": {
        "default": null,
        "description": "Project ID (optional)",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  }
}