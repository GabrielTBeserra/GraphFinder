{
  "description": "Lists vault notes with 1-line summaries and token estimates.",
  "name": "list_recent_notes",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "limit": {
        "description": "Maximum number of notes to return (default: 10)",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "project": {
        "description": "Target project/vault ID (optional)",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  }
}