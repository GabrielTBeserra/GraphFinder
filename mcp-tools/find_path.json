{
  "description": "BFS shortest path between two nodes across imports and wikilinks.",
  "name": "find_path",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "project": {
        "default": null,
        "description": "Project ID (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "source": {
        "description": "Origin node (file, symbol, note)",
        "type": "string"
      },
      "target": {
        "description": "Destination node",
        "type": "string"
      }
    },
    "required": [
      "source",
      "target"
    ],
    "type": "object"
  }
}