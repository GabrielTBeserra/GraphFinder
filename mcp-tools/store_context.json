{
  "description": "Saves or updates a vault note (chunking, tags, vectors). For edits to an existing section prefer update_section.",
  "name": "store_context",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "content": {
        "description": "Markdown body",
        "type": "string"
      },
      "links": {
        "description": "Wikilink targets (optional)",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "project": {
        "description": "Project ID (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "tags": {
        "description": "Context tags (optional)",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "title": {
        "description": "Note title",
        "type": "string"
      }
    },
    "required": [
      "title",
      "content"
    ],
    "type": "object"
  }
}