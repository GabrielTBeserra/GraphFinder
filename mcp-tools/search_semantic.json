{
  "description": "Atomic vector search over vault notes; returns ranked [[Note#Section]] excerpts. Use to answer questions; get_compressed_context for structure. fields='ids' for cheap 2-stage lookup.",
  "name": "search_semantic",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "fields": {
        "default": null,
        "description": "'ids': links + scores only",
        "type": [
          "string",
          "null"
        ]
      },
      "format": {
        "description": "'dense_chunks' (default) or 'summaries'",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "description": "Max chunks (default: 5)",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "max_chars": {
        "default": null,
        "description": "Response budget in chars (default: 8000)",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "offset": {
        "default": null,
        "description": "Pagination offset (default: 0)",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "project": {
        "description": "Project ID (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "queries": {
        "default": null,
        "description": "Batch: multiple queries in one call",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "query": {
        "description": "Search query",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  }
}