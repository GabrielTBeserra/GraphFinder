        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "from_note": {
            "description": "Source note title or ID",
            "type": "string"
          },
          "project": {
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "to_note": {
            "description": "Destination note title",
            "type": "string"
          }
        },
        "required": [
          "from_note",
          "to_note"
        ],
        "type": "object"
      }
