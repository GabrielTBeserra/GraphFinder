      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "direction": {
            "default": null,
            "description": "'imports' | 'imported_by' | 'both' (default)",
            "type": [
              "string",
              "null"
            ]
          },
          "file_path": {
            "description": "File path",
            "type": "string"
          },
          "project": {
            "default": null,
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "file_path"
        ],
        "type": "object"
      }
    },
    {
      "description": "Topological audit: communities, God Nodes, cross-coupling surprises. Start here for architecture questions.",
      "name": "get_community_report",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "format": {
            "default": null,
            "description": "'markdown' (default) or 'json'",
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "default": null,
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    {
      "description": "Returns a note's summary, section map with token estimates, tags and graph links. Use to pick a section, then read_section.",
      "name": "get_compressed_context",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "default": null,
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "description": "Note title or ID",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      }
    },
    {
      "description": "Structural map of one file: imports, dependents, external pkgs, symbols. Use before reading code; then read_code_chunk.",
      "name": "get_file_context",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "file_path": {
            "description": "File path or name",
            "type": "string"
          },
          "project": {
            "default": null,
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "file_path"
        ],
        "type": "object"
      }
    },
    {
      "description": "Lists 1-2 hop wikilink neighbors of a note. For the global map use get_community_report.",
      "name": "get_graph_neighborhood",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "depth": {
            "description": "Hops: 1 or 2 (default: 1)",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "project": {
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "description": "Note title or ID",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      }
    },
    {
      "description": "Returns counts: notes, code files, chunks, links, tags, tokens.",
      "name": "get_vault_stats",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "default": null,
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    {
      "description": "Creates a bidirectional wikilink between two notes.",
