{
  "schema_version": "1.0",
  "server": {
    "description": "GraphFinder Neural Knowledge Graph & Universal Code Intelligence MCP Server",
    "name": "graphfinder",
    "version": "0.21.0"
  },
  "tools": [
    {
      "description": "Creates an isolated project (markdown vault + vector index) at a path.",
      "name": "create_project",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "name": {
            "description": "Project name (e.g. 'Backend')",
            "type": "string"
          },
          "path": {
            "description": "Absolute folder path (optional)",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    {
      "description": "Deletes a note file and purges its vectors. Destructive.",
      "name": "delete_note",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "default": null,
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "description": "Note title or ID to delete",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      }
    },
    {
      "description": "360-degree context card: centrality, community, in/out edges, siblings. For the global map use get_community_report.",
      "name": "explain_node",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "default": null,
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "description": "Node (file, symbol, note)",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      }
    },
    {
      "description": "Exports graph.json, GRAPH_REPORT.md and standalone graph.html to disk.",
      "name": "export_graph",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "out_dir": {
            "default": null,
            "description": "Output dir (default: './graphfinder-out')",
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "default": null,
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    {
      "description": "Finds files by glob/name/language with import-degree stats. Use for paths; search_code for content.",
      "name": "find_files",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "fields": {
            "default": null,
            "description": "'ids': paths only",
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "default": null,
            "description": "Language filter (optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": null,
            "description": "Max files (default: 20)",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "default": null,
            "description": "Pagination offset (default: 0)",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "pattern": {
            "default": null,
            "description": "Glob/name match (e.g. '*.tsx', optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "default": null,
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    {
      "description": "BFS shortest path between two nodes across imports and wikilinks.",
      "name": "find_path",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "default": null,
            "description": "Project ID (optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "description": "Origin node (file, symbol, note)",
            "type": "string"
          },
          "target": {
            "description": "Destination node",
            "type": "string"
          }
        },
        "required": [
          "source",
          "target"
        ],
        "type": "object"
      }
    },
    {
