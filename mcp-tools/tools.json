{
  "schema_version": "1.0",
  "server": {
    "description": "GraphFinder Neural Knowledge Graph & Universal Code Intelligence MCP Server",
    "name": "graphfinder",
    "version": "0.0.1"
  },
  "tools": [
    {
      "description": "Creates a new isolated project with dedicated Markdown vault and SQLite vector index.",
      "name": "create_project",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "name": {
            "description": "Name of the new project (e.g. 'HomeLab', 'Finances', 'Backend')",
            "type": "string"
          },
          "path": {
            "description": "Optional absolute folder path on disk",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    {
      "description": "Deletes a note from the vault (removes .md file and purges vector records from SQLite).",
      "name": "delete_note",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "default": null,
            "description": "Target project/vault ID (optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "description": "Note title or ID to delete",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      }
    },
    {
      "description": "Generates a comprehensive 360° architectural context card for any symbol, file, or note.",
      "name": "explain_node",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "default": null,
            "description": "Target project/vault ID (optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "description": "Target node title, file path, or symbol",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      }
    },
    {
      "description": "Exports graph.json, GRAPH_REPORT.md, and standalone graph.html to disk.",
      "name": "export_graph",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "out_dir": {
            "default": null,
            "description": "Custom output directory (optional, defaults to './graphfinder-out')",
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "default": null,
            "description": "Target project/vault ID (optional)",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    {
      "description": "Quickly finds files in project codebase by name, glob pattern, or language, including connectivity degree in the dependency graph.",
      "name": "find_files",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "language": {
            "default": null,
            "description": "Filter by programming language (e.g. 'rust', 'typescript', optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": null,
            "description": "Maximum files to return (default: 20)",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "pattern": {
            "default": null,
            "description": "Glob pattern or file path match (e.g. '*.tsx', 'db.rs', 'engine', optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "default": null,
            "description": "Target project/vault ID (optional)",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    {
      "description": "Discovers shortest multi-hop dependency path connecting any two symbols, files, or notes.",
      "name": "find_path",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "project": {
            "default": null,
            "description": "Target project/vault ID (optional)",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "description": "Origin node title, file path, or symbol (e.g. 'App.tsx' or 'Note Title')",
            "type": "string"
          },
          "target": {
            "description": "Destination node title, file path, or symbol (e.g. 'db.rs')",
            "type": "string"
          }
        },
        "required": [
          "source",
          "target"
        ],
        "type": "object"
      }
    },
