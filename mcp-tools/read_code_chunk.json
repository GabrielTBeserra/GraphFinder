{
  "description": "Reads one symbol or line range from a file. Use after search_code/get_file_context locate the target.",
  "name": "read_code_chunk",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "file_path": {
        "description": "File path or name",
        "type": "string"
      },
      "project": {
        "default": null,
        "description": "Project ID (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "symbol_or_lines": {
        "default": null,
        "description": "Symbol name or line range (optional)",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "file_path"
    ],
    "type": "object"
  }
}