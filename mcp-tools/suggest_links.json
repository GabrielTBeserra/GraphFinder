{
  "description": "Scores draft text and suggests wikilinks to existing notes. Run before store_context.",
  "name": "suggest_links",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "current_note": {
        "description": "Note to exclude (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "project": {
        "description": "Project ID (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "text": {
        "description": "Draft text to link",
        "type": "string"
      },
      "threshold": {
        "description": "Min similarity 0-1 (default: 0.65)",
        "format": "float",
        "type": [
          "number",
          "null"
        ]
      }
    },
    "required": [
      "text"
    ],
    "type": "object"
  }
}