{
  "description": "Forward/reverse dependency report for a file: imports, importers, external pkgs, calls. Use for blast-radius analysis.",
  "name": "get_code_dependencies",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "direction": {
        "default": null,
        "description": "'imports' | 'imported_by' | 'both' (default)",
        "type": [
          "string",
          "null"
        ]
      },
      "file_path": {
        "description": "File path",
        "type": "string"
      },
      "project": {
        "default": null,
        "description": "Project ID (optional)",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "file_path"
    ],
    "type": "object"
  }
}