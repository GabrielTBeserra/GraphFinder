{
  "description": "Hybrid dense vector + BM25 search across project codebase. Returns function, class, or block excerpts with relevance scores and deep links [[file#symbol]].",
  "name": "search_code",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "language": {
        "default": null,
        "description": "Filter by programming language (e.g. 'rust', 'typescript', 'python', optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "default": null,
        "description": "Maximum code chunks to return (default: 5)",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "project": {
        "default": null,
        "description": "Target project/vault ID (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "query": {
        "description": "Semantic or exact search query for code symbols, functions, or concepts",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  }
}