{
  "description": "Hybrid BM25+vector code search; returns ranked [[file#symbol]] excerpts. Use to locate code; read full symbols with read_code_chunk. fields='ids' for cheap 2-stage lookup.",
  "name": "search_code",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "fields": {
        "default": null,
        "description": "'ids': [[file#symbol]] + scores only",
        "type": [
          "string",
          "null"
        ]
      },
      "language": {
        "default": null,
        "description": "Language filter (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "default": null,
        "description": "Max chunks (default: 5)",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "max_chars": {
        "default": null,
        "description": "Response budget in chars (default: 8000)",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "offset": {
        "default": null,
        "description": "Pagination offset (default: 0)",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "project": {
        "default": null,
        "description": "Project ID (optional)",
        "type": [
          "string",
          "null"
        ]
      },
      "queries": {
        "default": null,
        "description": "Batch: multiple queries in one call",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "query": {
        "description": "Code search query",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  }
}