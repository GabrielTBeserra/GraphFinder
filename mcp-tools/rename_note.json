{
  "description": "Renames a note and rewrites all incoming [[wikilinks]] vault-wide.",
  "name": "rename_note",
  "parameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "new_title": {
        "description": "New title",
        "type": "string"
      },
      "old_title": {
        "description": "Current title or ID",
        "type": "string"
      },
      "project": {
        "default": null,
        "description": "Project ID (optional)",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "old_title",
      "new_title"
    ],
    "type": "object"
  }
}